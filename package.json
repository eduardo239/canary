{
  "name": "canary9",
  "displayName": "Canary9",
  "description": "Early warning for vulnerable dependencies: scans your workspace (npm, pnpm, yarn, pip and uv) against the OSV.dev database.",
  "version": "0.4.0",
  "publisher": "eduardo239",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardo239/canary.git"
  },
  "homepage": "https://github.com/eduardo239/canary#readme",
  "bugs": {
    "url": "https://github.com/eduardo239/canary/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted folders, Canary only reads manifests and shows alerts; the action that runs \"uv lock\" in the terminal is disabled."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Canary reads files from the local disk."
    }
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "osv",
    "npm",
    "python",
    "cve",
    "uv",
    "pnpm",
    "yarn"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/requirements*.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/uv.lock",
    "workspaceContains:**/pnpm-lock.yaml",
    "workspaceContains:**/yarn.lock"
  ],
  "contributes": {
    "commands": [
      {
        "command": "canary.scan",
        "title": "Scan for vulnerabilities",
        "category": "Canary",
        "icon": "$(refresh)"
      },
      {
        "command": "canary.exportReport",
        "title": "Export vulnerability report",
        "category": "Canary",
        "icon": "$(export)"
      },
      {
        "command": "canary.clear",
        "title": "Clear results",
        "category": "Canary",
        "icon": "$(clear-all)"
      },
      {
        "command": "canary.openAdvisory",
        "title": "Open advisory",
        "category": "Canary"
      },
      {
        "command": "canary.uvUpgrade",
        "title": "Upgrade package with uv lock",
        "category": "Canary"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canary.openAdvisory",
          "when": "false"
        },
        {
          "command": "canary.uvUpgrade",
          "when": "false"
        },
        {
          "command": "canary.exportReport",
          "when": "canary.hasFindings"
        }
      ],
      "view/title": [
        {
          "command": "canary.scan",
          "when": "view == canary.results",
          "group": "navigation@1"
        },
        {
          "command": "canary.exportReport",
          "when": "view == canary.results && canary.hasFindings",
          "group": "navigation@2"
        },
        {
          "command": "canary.clear",
          "when": "view == canary.results",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canary",
          "title": "Canary",
          "icon": "media/canary.svg"
        }
      ]
    },
    "views": {
      "canary": [
        {
          "id": "canary.results",
          "name": "Vulnerabilities"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "canary.results",
        "contents": "No vulnerabilities found (or no scan has run yet).\n[Scan now](command:canary.scan)"
      }
    ],
    "configuration": {
      "title": "Canary",
      "properties": {
        "canary.scanOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Scan the workspace automatically when it opens."
        },
        "canary.scanOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Scan again when manifests or lockfiles change (package.json, package-lock.json, pnpm-lock.yaml, yarn.lock, requirements*.txt, pyproject.toml, uv.lock)."
        },
        "canary.includeDevDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Include development dependencies (npm devDependencies, [dependency-groups] and tool.uv.dev-dependencies)."
        },
        "canary.exclude": {
          "type": "string",
          "default": "**/{node_modules,.venv,venv,.git,dist,out,build}/**",
          "description": "Glob of folders to skip when looking for manifests."
        },
        "canary.ignorePackages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Packages that are **not** scanned or sent to OSV.dev (useful for internal/private packages). Accepts `*` and an optional ecosystem prefix. E.g. `@mycompany/*`, `npm:internal-*`, `pypi:mycompany-*`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "smoke": "npm run compile && node scripts/smoke.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  }
}
