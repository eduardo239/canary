{
  "name": "canary",
  "displayName": "Canary",
  "description": "Alerta precoce de vulnerabilidades: analisa as dependências do workspace (npm, pnpm, pip e uv) usando a base OSV.dev.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "osv",
    "npm",
    "python",
    "cve",
    "uv",
    "pnpm"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/requirements*.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/uv.lock",
    "workspaceContains:**/pnpm-lock.yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "canary.scan",
        "title": "Verificar vulnerabilidades",
        "category": "Canary",
        "icon": "$(refresh)"
      },
      {
        "command": "canary.clear",
        "title": "Limpar resultados",
        "category": "Canary",
        "icon": "$(clear-all)"
      },
      {
        "command": "canary.openAdvisory",
        "title": "Abrir advisory",
        "category": "Canary"
      },
      {
        "command": "canary.runInTerminal",
        "title": "Executar comando de correção",
        "category": "Canary"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "canary.openAdvisory",
          "when": "false"
        },
        {
          "command": "canary.runInTerminal",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "canary.scan",
          "when": "view == canary.results",
          "group": "navigation@1"
        },
        {
          "command": "canary.clear",
          "when": "view == canary.results",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canary",
          "title": "Canary",
          "icon": "media/canary.svg"
        }
      ]
    },
    "views": {
      "canary": [
        {
          "id": "canary.results",
          "name": "Vulnerabilidades"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "canary.results",
        "contents": "Nenhuma vulnerabilidade encontrada (ou nenhuma verificação feita ainda).\n[Verificar agora](command:canary.scan)"
      }
    ],
    "configuration": {
      "title": "Canary",
      "properties": {
        "canary.scanOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Verifica o workspace automaticamente ao abrir."
        },
        "canary.scanOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Verifica novamente quando manifestos ou lockfiles mudam (package.json, package-lock.json, pnpm-lock.yaml, requirements*.txt, pyproject.toml, uv.lock)."
        },
        "canary.includeDevDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Inclui dependências de desenvolvimento (devDependencies do npm, [dependency-groups] e tool.uv.dev-dependencies)."
        },
        "canary.exclude": {
          "type": "string",
          "default": "**/{node_modules,.venv,venv,.git,dist,out,build}/**",
          "description": "Glob de pastas ignoradas ao procurar manifestos."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "smoke": "npm run compile && node scripts/smoke.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  }
}
